# ========================================================
# LeadHunter Pro - Environment Configuration
# ========================================================

# Database (MySQL 8.0)
MYSQL_ROOT_PASSWORD="root_password"
MYSQL_DATABASE="leadhunterpro"
MYSQL_USER="leadhunter_user"
MYSQL_PASSWORD="leadhunter_password"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"

# C# .NET 8 Web API
ASPNETCORE_ENVIRONMENT="Development"
JWT_SECRET_KEY="YOUR_STRONG_JWT_SECRET_KEY_MIN_32_CHARS_LONG_HERE_2026"
JWT_ISSUER="LeadHunterPro"
JWT_AUDIENCE="LeadHunterProClient"

# Third-Party APIs
GOOGLE_PLACES_API_KEY="AIzaSyA89vK2-YOUR_GOOGLE_PLACES_KEY"
SERP_API_KEY="YOUR_SERP_API_KEY"
HUNTER_IO_API_KEY="YOUR_HUNTER_IO_KEY"

# Outbound Messaging Channels
TWILIO_ACCOUNT_SID="AC_YOUR_TWILIO_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
SENDGRID_API_KEY="SG.YOUR_SENDGRID_KEY"
SENDGRID_SENDER_EMAIL="outreach@yourdomain.com"
TWITTER_BEARER_TOKEN="YOUR_TWITTER_BEARER_TOKEN"
INSTAGRAM_ACCESS_TOKEN="YOUR_INSTAGRAM_GRAPH_TOKEN"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Hangfire Background Job Schedules (Cron format)
HANGFIRE_CRON_DAILY_FETCH="0 0 * * *"
HANGFIRE_CRON_WEBSITE_CHECK="0 2 * * *"
HANGFIRE_CRON_EMAIL_ENRICHMENT="0 3 * * *"

# AI Studio Injection
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
